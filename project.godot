; 로그라이크 - Godot 4.7
; 에셋은 test3(img2model) 카탈로그가 만든 것을 그대로 씁니다.

config_version=5

[application]

config/name="TOTO FIGHTCLUB"
config/description="test3 카탈로그 에셋으로 만든 3D 액션 로그라이크"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[audio]

; 웹에서는 샘플레이트를 **강제하지 않습니다**(0 = 기기 값을 그대로).
;
; 엔진의 웹 오디오는 `if (mix_rate) { opts.sampleRate = mix_rate }` 로 만듭니다.
; 기본값 44100 이 들어가면 `new AudioContext({sampleRate: 44100})` 가 되는데,
; 아이폰 오디오 장치는 대개 48000 이라 안 맞는 값을 강제하면 컨텍스트는
; running 인데 소리가 안 나옵니다 - 사파리에서 실제로 그랬습니다.
;
; 데스크톱은 그대로 44100 을 씁니다. 거기서는 문제가 없었고, 굳이 건드려
; 멀쩡한 쪽을 흔들 이유가 없습니다.
driver/mix_rate.web=0

[physics]

; **한 프레임이 늦었을 때 물리가 몇 번까지 따라잡나.** 기본은 8 입니다.
;
; 폰 기록에서 나쁜 프레임의 물리가 3~8ms 가 아니라 29.3 · 57.3ms 였습니다.
; 한 번 늦은 프레임이 물리를 여덟 번 돌게 하고, 그 여덟 번이 다음 프레임까지
; 늦추는 굴레입니다 - 손에는 "한 번 끊기면 잠깐 계속 끊긴다" 로 느껴집니다.
;
; 그 프레임에 잔상이 셋넷씩 찍힌 것도 같은 일입니다. 잔상은 물리 단계에서
; 떨구므로, 물리가 여덟 번 돌면 잔상도 여덟 장입니다 - 원인이 아니라 자국이
; 었습니다.
;
; 2 로 낮춥니다. 따라잡기를 포기하면 그 순간 판이 아주 잠깐 느려지지만,
; **굴레가 끊깁니다.** 늦은 것을 따라잡느라 계속 늦는 것보다 낫습니다.
common/max_physics_steps_per_frame=2

[rendering]

; 웹은 Forward+ 를 못 씁니다(WebGPU 는 아직 실험 단계). Compatibility 로 내립니다.
; 데스크톱은 그대로 Forward+ 입니다 - 같은 프로젝트가 두 길로 나갑니다.
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
; Compatibility 는 오브젝트당 광원 수에 한계가 있습니다. 바닥이 한 덩어리
; 메시라 방 조명이 전부 걸리므로, 기본값 8 이면 안쪽 방이 어두워집니다.
limits/opengl/max_lights_per_object=16
; 폰 GPU 는 S3TC 를 못 읽습니다. ETC2/ASTC 로도 가져옵니다.
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.05, 0.04, 0.04, 1)
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
